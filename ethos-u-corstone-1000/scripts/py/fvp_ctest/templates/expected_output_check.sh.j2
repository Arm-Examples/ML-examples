# Template fragment that reports whether one expected application output exists.

# This fragment is included by run_ctest_one.sh.j2 for each expected
# output file.

{% macro expected_output_check(test_name, output_file) -%}
if test -f {{ output_file | shell_quote }}; then
  echo {{ ("APP_OUTPUT:" ~ test_name ~ ":" ~ output_file) | shell_quote }}
else
  echo {{ ("APP_MISSING_OUTPUT:" ~ test_name ~ ":" ~ output_file) | shell_quote }}
  exit 126
fi
{%- endmacro %}
