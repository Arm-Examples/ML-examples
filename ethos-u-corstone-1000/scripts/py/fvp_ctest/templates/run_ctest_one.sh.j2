# Template for the target-side shell script that runs one CTest application.

set -u

cd "$(dirname "$0")/.." || exit 125
mkdir -p {{ output_dir | shell_quote }}
echo {{ ("APP_START:" ~ test_name) | shell_quote }}
LD_LIBRARY_PATH=./lib{% for command_arg in command %} {{ command_arg | shell_quote }}{% endfor %}
app_status=$?
echo {{ ("APP_EXIT:" ~ test_name ~ ":") | shell_quote }}"${app_status}"
if test "${app_status}" -ne 0; then
  exit "${app_status}"
fi
{% from "expected_output_check.sh.j2" import expected_output_check %}
{% for output_file in expected_outputs %}
{{ expected_output_check(test_name, output_file) }}
{% endfor %}
exit 0
